# Sanity CMS Configuration
# Get your Project ID and create a Dataset at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Sanity API Tokens (Generate under Project Settings -> API -> Tokens in Sanity Dashboard)
# SANITY_API_WRITE_TOKEN requires "Editor" or "Contributor" permissions to create contactMessage documents.
SANITY_API_WRITE_TOKEN=your_sanity_write_token
